{
  "info": {
    "name": "M-Team API",
    "description": "Coleccion local para las 69 operaciones montadas y documentadas en backend/docs/openapi.yaml. Secuencia recomendada: getHealth, registerMember o provisionar datos sintéticos, login, getCurrentIdentity y luego las carpetas por rol. Las escrituras y cambios de estado deben ejecutarse sólo contra una base local descartable. Usa el entorno M-Team local, no apunta a proveedores productivos y no contiene credenciales reales. Precondiciones: usar datos @example.test o equivalentes sintéticos, completar IDs devueltos por requests previas y mantener una cuenta ADMIN/TRAINER/MEMBER local según la carpeta. Ejemplos de errores locales: 400 con cuerpo inválido, 401 sin Bearer o con token revocado, 403 usando un rol insuficiente, 404 con un UUID no creado y 409 repitiendo una clave única o una Idempotency-Key con payload distinto. No ejecutar esos escenarios contra Render, Supabase productivo ni otra base compartida.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const documentedStatuses = [200, 201, 202, 204, 400, 401, 403, 404, 409, 429, 500, 502, 503];",
          "const expectedSuccessStatuses = { getOwnMembership: [200], getCurrentMembershipPrice: [200], createMembershipPrice: [201], createBranch: [201], updateBranch: [200], listAdminBranches: [200], listEvents: [200], createEvent: [201], getEvent: [200], updateEvent: [200], updateEventStatus: [200], listNewsPosts: [200], createNewsPost: [201], getNewsPost: [200], updateNewsPost: [200], updateNewsPostStatus: [200], createPayment: [201] };",
          "const expectedFields = { getOwnMembership: ['currentPrice', 'lastPaymentAt', 'expiresAt', 'daysRemaining', 'status'], getCurrentMembershipPrice: ['id', 'amount', 'effectiveFrom', 'createdAt', 'createdById'], createMembershipPrice: ['id', 'amount', 'effectiveFrom', 'createdAt', 'createdById'], createBranch: ['id', 'name', 'address', 'openingHours', 'phone', 'description', 'imageUrl', 'isActive'], updateBranch: ['id', 'name', 'address', 'openingHours', 'phone', 'description', 'imageUrl', 'isActive'], getBranch: ['id', 'name', 'address', 'isActive'], getAdminBranch: ['id', 'name', 'address', 'isActive'], createEvent: ['id', 'title', 'description', 'startsAt', 'location', 'imageUrl', 'status', 'createdById'], getEvent: ['id', 'title', 'description', 'startsAt', 'location', 'imageUrl', 'status', 'createdById'], updateEvent: ['id', 'title', 'description', 'startsAt', 'location', 'imageUrl', 'status', 'createdById'], updateEventStatus: ['id', 'title', 'description', 'startsAt', 'location', 'imageUrl', 'status', 'createdById'], createNewsPost: ['id', 'title', 'content', 'audience', 'status', 'createdById'], getNewsPost: ['id', 'title', 'content', 'audience', 'status', 'createdById'], updateNewsPost: ['id', 'title', 'content', 'audience', 'status', 'createdById'], updateNewsPostStatus: ['id', 'title', 'content', 'audience', 'status', 'createdById'], createPayment: ['id', 'memberId', 'amount', 'method', 'status', 'createdById', 'createdAt', 'confirmedById', 'accreditedAt', 'expiresAt'] };",
          "const requestName = pm.info.requestName;",
          "pm.test('HTTP status is documented by the API contract', function () { pm.expect(documentedStatuses).to.include(pm.response.code); });",
          "if (expectedSuccessStatuses[requestName]) { pm.test('HTTP status matches the documented success response', function () { pm.expect(expectedSuccessStatuses[requestName]).to.include(pm.response.code); }); }",
          "let responseBody = null;",
          "if (pm.response.text()) { try { responseBody = pm.response.json(); } catch (_) { responseBody = null; } }",
          "if (responseBody && expectedFields[requestName] && pm.response.code >= 200 && pm.response.code < 300) { pm.test('Response exposes essential fields', function () { expectedFields[requestName].forEach(function (field) { pm.expect(responseBody).to.have.property(field); }); }); }",
          "if (responseBody && pm.response.code >= 400) { pm.test('Error response exposes the standard error contract', function () { pm.expect(responseBody).to.have.property('code'); pm.expect(responseBody).to.have.property('message'); }); }",
          "const requestUrl = pm.request.url.toString().toLowerCase();",
          "pm.test('Request is not configured for a production provider', function () { pm.expect(requestUrl).to.not.match(/render\\.com|supabase\\.co/); });",
          "if (pm.response.code >= 200 && pm.response.code < 300 && pm.response.text()) { pm.test('Successful response is JSON', function () { pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json'); }); }",
          "if (pm.response.text()) { try { const body = pm.response.json(); if (body && Array.isArray(body.items)) { pm.test('Paginated responses expose pagination metadata', function () { pm.expect(body).to.have.property('page'); pm.expect(body).to.have.property('limit'); pm.expect(body).to.have.property('total'); }); } } catch (error) { if (pm.response.code >= 200 && pm.response.code < 300) { pm.test('Response body is valid JSON', function () { throw error; }); } } }"
        ]
      }
    }
  ],
