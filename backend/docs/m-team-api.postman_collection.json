      "name": "System and authentication",
      "item": [
        {
          "name": "requestPasswordRecovery",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"member@example.test\"}" },
            "url": "{{baseUrl}}/auth/password-recovery"
          }
        },
        {
          "name": "completePasswordRecovery",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"token\":\"{{recoveryToken}}\",\"newPassword\":\"ChangeMe123!\"}" },
            "url": "{{baseUrl}}/auth/password-recovery/complete"
          }
        },
        {
          "name": "getHealth",
          "request": { "method": "GET", "auth": { "type": "noauth" }, "url": "{{baseUrl}}/health" }
        },
        {
          "name": "registerMember",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"firstName\":\"Test\",\"lastName\":\"Member\",\"documentNumber\":\"TEST-001\",\"birthDate\":\"1990-01-01\",\"email\":\"member@example.test\",\"phone\":\"1122334455\",\"password\":\"ChangeMe123!\"}" },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "login",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"member@example.test\",\"password\":\"ChangeMe123!\"}" },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Login returns an access token', function () { pm.expect(body.accessToken).to.be.a('string').and.not.empty; });",
                  "if (body.accessToken) pm.environment.set('token', body.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "logout",
          "request": { "method": "POST", "url": "{{baseUrl}}/auth/logout" }
        },
