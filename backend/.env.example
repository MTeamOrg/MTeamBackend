# Runtime environment
NODE_ENV=development
APP_ENV=development
PORT=3000

# PostgreSQL / Prisma
DATABASE_URL=
DIRECT_URL=

# Authentication
JWT_SECRET=
# Token lifetime in seconds
JWT_EXPIRES_IN=3600

# Supabase Storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
# Public bucket used only for profile photos
SUPABASE_PROFILE_PHOTO_BUCKET=

# Frontend origin allowed by CORS
CORS_ORIGIN=http://localhost:5173


# Account recovery (USR-04). Configure a verified sender in Resend.
FRONTEND_PUBLIC_URL=http://localhost:5173
RESEND_API_KEY=
MAIL_FROM=M-Team <recuperacion@example.com>
